# 复制成 .env 再填真值。.env 在 .gitignore 里，不会进版本库。
#
# 这些值本地开发时用默认即可；上线必须改。

# 服务端口与监听地址。
# 用 nginx 反代时保持 127.0.0.1；直接对外才改成 0.0.0.0
AGENT_PORT=8300
BIND_HOST=127.0.0.1

# 两个目标系统。本地是 127.0.0.1，上线换成本机地址或内网地址。
OA_BASE_URL=http://127.0.0.1:8100
FIN_BASE_URL=http://127.0.0.1:8200

# 浏览器：服务器没有桌面，必须无头（1）。本地想看它跑就设 0。
BROWSER_HEADLESS=1

# 控制台登录 cookie：上了 HTTPS 之后改成 1，否则永远 0
COOKIE_SECURE=0

# 控制台会话签名密钥。线上必须换成一串随机值：
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CONSOLE_SECRET=change-me-in-production

# 财务系统的评测旁路接口 token（只有评测脚本用）
FIN_ADMIN_TOKEN=change-me-in-production

# LLM（DeepSeek 兼容接口）
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
