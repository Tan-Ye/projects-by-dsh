# 复制成 .env 再填真值。.env 在 .gitignore 里，不会进版本库。
#
# 这些值本地开发时用默认即可；上线必须改。

# 服务端口
AGENT_PORT=8300

# 两个目标系统。本地是 127.0.0.1，上线换成域名。
OA_BASE_URL=http://127.0.0.1:8100
FIN_BASE_URL=http://127.0.0.1:8200

# LLM（DeepSeek 兼容接口）
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
