# 生产环境变量（agent）

# 只监听回环，由 nginx 反代
BIND_HOST=127.0.0.1
AGENT_PORT=8300

# 目标系统：同一台机器上的两个仿真系统
OA_BASE_URL=http://127.0.0.1:8100
FIN_BASE_URL=http://127.0.0.1:8200

# 服务器没有桌面
BROWSER_HEADLESS=1

# 先 HTTP 跑；上了证书改成 1
COOKIE_SECURE=0

# 必须换掉：python -c "import secrets; print(secrets.token_urlsafe(32))"
CONSOLE_SECRET=填一串随机值

# 必须和 systems/fin/.env 里的 FIN_ADMIN_TOKEN 完全一致
FIN_ADMIN_TOKEN=填一串随机值

# DeepSeek
LLM_API_KEY=sk-填真的
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 财务系统的制单账号（agent 用；复核永远是人）
FIN_USERNAME=maker
FIN_PASSWORD=maker123
